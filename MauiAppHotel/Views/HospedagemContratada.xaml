<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Resumo da Reserva"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout Padding="20"
                         Spacing="12"
                         VerticalOptions="Center">

        <Label Text="Resumo da Reserva"
               FontFamily="Kalam"
               FontSize="40"
               TextColor="{StaticResource Primary}" />
        <Label Text="{Binding QuartoEscolhido.Descricao, StringFormat='Quarto: {0}'}" />
        <Label Text="{Binding Adultos, StringFormat='Adultos: {0}'}" />
        <Label Text="{Binding Criancas, StringFormat='Crianças: {0}'}" />
        <Label Text="{Binding DataCheckIn, StringFormat='Check-in: {0:dd/MM/yyyy}'}" />
        <Label Text="{Binding DataCheckOut, StringFormat='Check-out: {0:dd/MM/yyyy}'}" />
        <Label Text="{Binding Estadia, StringFormat='Dias de estadia: {0}'}" />

        <Label Text="{Binding ValorTotal, StringFormat='Valor total: R$ {0:N2}'}"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}" />

    </VerticalStackLayout>
</ContentPage>